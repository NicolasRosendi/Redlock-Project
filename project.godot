; Engine configuration file.
; Proyecto Godot 4.3+

config_version=5

[application]

config/name="Redlock Project"
config/description="Prototipo de gameplay de fútbol arcade (inspirado en Blue Lock, Captain Tsubasa y FIFA)."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/autoload/game_config.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
FX="*res://scripts/autoload/fx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
